FFFFF" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;fontStyle=1;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="70" width="420" height="500" as="geometry"/></mxCell><mxCell id="c4" value="0x00000000   unmapped&#10;(so a NULL dereference faults)" style="fillColor=none;strokeColor=#444444;dashed=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="120" y="120" width="340" height="45" as="geometry"/></mxCell><mxCell id="c5" value="0x00001000   initial user code&#10;(USER_SPACE_VADDR)" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="120" y="180" width="340" height="45" as="geometry"/></mxCell><mxCell id="c6" value="ELF text / data / bss&#10;(loaded by execve)" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="120" y="240" width="340" height="45" as="geometry"/></mxCell><mxCell id="c7" value="heap   (brk, grows up)" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="120" y="300" width="340" height="40" as="geometry"/></mxCell><mxCell id="c8" value="user stack   (grows down)" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="120" y="480" width="340" height="40" as="geometry"/></mxCell><mxCell id="c9" value="Private to the process.&#10;Switching process swaps only&#10;this half — TTBR0 is pointed at&#10;the new level-1 table." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="120" y="350" width="340" height="120" as="geometry"/></mxCell><mxCell id="c10" value="Kernel   0xC0000000 … 0xFFFFFFFF" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;fontStyle=1;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="70" width="420" height="500" as="geometry"/></mxCell><mxCell id="c11" value="0xC0008000   vectors + .head.text" style="fillColor=#dae8fc;strokeCo