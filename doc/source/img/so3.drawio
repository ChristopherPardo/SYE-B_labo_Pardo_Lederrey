ipts/syscall_gen.sh turns syscall.tbl and arch/arm32/syscall.h.in into generated/syscall_table.h.in and syscall_number.h, so the kernel and the MUSL libc always agree on the numbering." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="1000" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="build" id="build"><mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Infrabase build &amp; deploy flow" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1080" height="30" as="geometry"/></mxCell><mxCell id="c3" value="build/conf/local.conf&#10;&#10;IB_PLATFORM = virt32&#10;IB_CONFIG:so3 · IB_TARGET_ITS:so3" style="fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="110" as="geometry"/></mxCell><mxCell id="c4" value="scripts/build.sh&#10;bsp-so3   (recipe positional)" style="fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="78" width="230" height="74" as="geometry"/></mxCell><mxCell id="c5" value="bitbake&#10;meta-* layers + recipes" style="fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="78" width="230" height="74" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="Recipes (meta-* layers)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;fontStyle=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="1020" height="175" as="geometry"/></mxCell><mxCell id="c9" value="so3 kernel&#10;(meta-so3)&#10;&#10;IN-TREE&#10;Kconfig + dts" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="245" width="150" height="110" as="geometry"/></mxCell><mxCell id="c10" value="u-boot&#10;(meta-uboot)&#10;&#10;fetched&#10;+ patched" style="fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="265" y="245" width="150" height="110" as="geometry"/></mxCell><mxCell id="c11" value="qemu&#10;(meta-qemu)&#10;&#10;fetched&#10;+ patched" style="fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="245" width="150" height="110" as="geometry"/></mxCell><mxCell id="c12" value="usr-so3&#10;(meta-usr)&#10;&#10;CMake + MUSL&#10;(meta-toolchain)" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="655" y="245" width="150" height="110" as="geometry"/></mxCell><mxCell id="c13" value="rootfs-so3&#10;(meta-rootfs)" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="850" y="245" width="160" height="50" as="geometry"/></mxCell><mxCell id="c14" value="bsp-so3&#10;(meta-bsp)" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="850" y="305" width="160" height="50" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;exitX=0.5;exitY=1;entryX=0.73;entryY=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="do_itb → render + mkimage&#10;files/its/*.its  →  so3/images/*.itb" style="fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="420" width="250" height="64" as="geometry"/></mxCell><mxCell id="c17" value="scripts/deploy.sh bsp-so3&#10;→ sdcard.img.virt32  (FAT boot + rootfs)" style="fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="420" width="250" height="64" as="geometry"/></mxCell><mxCell id="c18" value="scripts/st.sh  [-d]&#10;→ QEMU virt32 (Cortex-A15)" style="fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="420" width="270" height="64" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="SO3 kernel and user space are built IN-TREE (committed sources) — that is what you edit during the labs. u-boot and qemu are FETCHED and local edits are kept as patches: edit the source, then &#x27;scripts/updiff.sh RECIPE&#x27; regenerates files/000N-*.patch (diff of S.pristine vs the working tree)." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1020" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>