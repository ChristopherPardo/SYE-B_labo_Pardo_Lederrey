m><diagram name="syscall" id="syscall"><mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="System call path (ARM 32-bit)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1080" height="30" as="geometry"/></mxCell><mxCell id="c3" value="USR — user code&#10;r7 = syscall number&#10;r0..r5 = arguments&#10;svc" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="210" height="80" as="geometry"/></mxCell><mxCell id="c4" value="vector table (__vectors)&#10;“software interrupt” slot&#10;→ syscall_interrupt" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="220" height="80" as="geometry"/></mxCell><mxCell id="c5" value="syscall_interrupt&#10;save r0-r12, SPSR,&#10;banked sp/lr of USR" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="90" width="230" height="80" as="geometry"/></mxCell><mxCell id="c6" value="arch_syscall_handle()&#10;(ARM TLS calls)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="870" y="90" width="190" height="80" as="geometry"/></mxCell><mxCell id="c7" value="syscall_handle()&#10;check nr &lt; NR_SYSCALLS" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="870" y="230" width="190" height="80" as="geometry"/></mxCell><mxCell id="c8" value="syscall_table[nr]&#10;generated from&#10;syscall.tbl" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="230" width="230" height="80" as="geometry"/></mxCell><mxCell id="c9" value="sys_xxx()&#10;SYS